# ─────────────────────────────────────────────────────────────────────────────
# agent-os — environment variables
# Copy to .env and fill in your values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLMs ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY
OLLAMA_HOST=http://localhost:11434          # local Ollama; or GPU node address
OLLAMA_API_BASE=http://localhost:11434
GEMINI_API_KEY=REPLACE_IF_USING_GEMINI    # optional
OPENMODEL_API_KEY=REPLACE_IF_USING_OPENMODEL
OPENMODEL_API_BASE=https://api.openmodel.ai
OPENMODEL_MODEL=deepseek-v4-flash
OPENMODEL_ENABLED=0                       # enable only while account has credit
LLM_FALLBACK_MODELS=gemini/gemini-3.6-flash,groq/openai/gpt-oss-120b
FREEQWEN_ENABLED=0                       # optional web proxy; enable only after a successful smoke test

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
OPS_DB_HOST=127.0.0.1
OPS_DB_PORT=5432
OPS_DB_USER=agent_user

# ── Telegram (orchestrator bot) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_MY_ID=REPLACE_WITH_YOUR_USER_ID       # your numeric Telegram user ID
TELEGRAM_CHANNEL_ID=                           # channel for content publishing (optional)
TELEGRAM_API_ID=REPLACE_IF_USING_MTProto
TELEGRAM_API_HASH=REPLACE_IF_USING_MTProto
TELEGRAM_PHONE=REPLACE_IF_USING_MTProto

# ── Hypothesis Hub (read-only product analytics for Emilia) ──────────────────
HYPOTHESIS_HUB_API_URL=http://127.0.0.1:3001
HYPOTHESIS_HUB_TOKEN=                    # required when Hub runs in production

# ── Support bot (separate token) ──────────────────────────────────────────────
SUPPORT_BOT_TOKEN=REPLACE_WITH_SUPPORT_BOT_TOKEN

# ── Gmail (email watchdog) ────────────────────────────────────────────────────
GMAIL1_EMAIL=your@gmail.com
GMAIL1_PASSWORD=REPLACE_WITH_APP_PASSWORD     # Google App Password (not account pw)

# ── Task management ───────────────────────────────────────────────────────────
WEEEK_TOKEN=REPLACE_WITH_WEEEK_API_TOKEN
WEEEK_FUNNEL_ID=
WEEEK_STAGE_NEW=
WEEEK_STAGE_CONTACTED=
WEEEK_STAGE_QUALIFIED=
WEEEK_STAGE_PROPOSAL=

# ── Knowledge base ────────────────────────────────────────────────────────────
OBSIDIAN_VAULT=/path/to/your/obsidian/vault

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=REPLACE_IF_USING_LANGFUSE
LANGFUSE_PUBLIC_KEY=REPLACE_IF_USING_LANGFUSE
LANGFUSE_HOST=http://localhost:3000

# ── docker-compose infra secrets (used by docker-compose.yml) ────────────────
# Generate fresh values, e.g.:  openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32   # Langfuse session secret
LANGFUSE_SALT=REPLACE_WITH_openssl_rand_base64_16     # Langfuse hashing salt
N8N_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_24 # n8n credential encryption key

# ── Dashboard ─────────────────────────────────────────────────────────────────
INFRA_DASH_URL=http://localhost:8099
INFRA_DASH_BIND=127.0.0.1                # bind address; keep localhost unless you front it with a proxy
INFRA_DASH_ORIGIN=http://localhost:8099  # allowed CORS origin
DASH_TOKEN=                              # set a random token to require auth on mutating POST endpoints
